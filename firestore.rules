rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Allow read and write to all documents in the site_data collection
    // This allows website settings (maintenance mode, branding, etc.),
    // dynamic CMS content, staff accounts, applications, and logs to sync globally.
    match /site_data/{document=**} {
      allow read, write: if true;
    }

    // Allow read and write to any root-level collection
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
